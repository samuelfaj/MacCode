      {"code": -32094, "name": "idempotencyOwnerMismatch", "retryable": false, "requiresSnapshot": false},
      {"code": -32093, "name": "idempotencyRequestMismatch", "retryable": false, "requiresSnapshot": false},
      {"code": -32092, "name": "legacyReceiptUnverifiable", "retryable": false, "requiresSnapshot": true},
      {"code": -32091, "name": "commandReceiptUnavailable", "retryable": true, "requiresSnapshot": false}
    ],
    "failureDataFields": ["reason", "method", "clientRequestId", "retryable", "requiresSnapshot"],
    "statusResponseFields": ["status", "method", "clientRequestId", "retryable", "requiresSnapshot"],
    "forbiddenResponseFields": ["ownerFingerprint", "params", "token", "path", "prompt", "commandText"]
